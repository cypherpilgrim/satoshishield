# SatoshiShield Monitor — Environment Configuration Template
#
# Copy this file to /opt/satoshishield/.env on the Proxmox host
# and fill in your own values. Never commit the actual .env file
# to git. It is already in .gitignore.
#
# After creating the .env file, lock down its permissions:
#   chmod 600 /opt/satoshishield/.env
#
# See docs/SatoshiShield_Monitor_Deployment_v1_4.docx for full setup.

# SMTP relay credentials (Gmail, Proton Bridge, or any standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-relay-account@example.com
SMTP_PASSWORD=your-smtp-app-password

# Where the monthly report comes from and where it goes
REPORT_FROM=your-relay-account@example.com
REPORT_TO=where-the-report-should-be-delivered@example.com
